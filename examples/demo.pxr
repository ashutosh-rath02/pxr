# Controller-local milliseconds. Resource 0 = motor; 1 = gripper.
lease 0 500
# action CAP ID SEQUENCE P0 P1 DEADLINE VALID_FOR EPOCH EXECUTE_AFTER
action 1 1 1 400 200 20 100 2 0
action 1 1 1 400 200 20 100 2 0
action 1 2 2 1001 0 20 100 2 0
advance 20
action 1 3 3 100 0 20 100 2 0
advance 80
# Stream expires, fallback zeroes motor and revokes its lease; epoch becomes 3.
lease 1 500
action 3 4 4 0 0 120 100 4 100
action 4 5 5 0 0 120 100 4 100
estop
state 0
recover
